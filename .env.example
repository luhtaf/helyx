NODE_ENV=development
LOG_LEVEL=info

BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=          # set any value (local docker only); also referenced by docker-compose.yml
NEO4J_DATABASE=neo4j

OTX_API_KEY=
NVD_API_KEY=

ELK_BASE_URL=http://elk.th
ELK_USERNAME=
ELK_PASSWORD=
ELK_CVE_INDEX=list-cve

JWT_SECRET=
JWT_EXPIRES_IN=7d

# F2 — at-rest encryption key for per-org CTI signing keypairs.
# Separate secret tier from JWT_SECRET (data-at-rest crypto, not session auth).
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CTI_SIGNING_MASTER_KEY=

# Cache + auth state (Redis 7+)
REDIS_URL=redis://localhost:6379

# Cookies / CORS / proxy
COOKIE_SECURE=false                       # set true in prod (HTTPS only)
CORS_ORIGIN=http://localhost:5173         # frontend origin (exact, no wildcard)
TRUST_PROXY_HOPS=0                        # 1 if behind nginx/Cloudflare

# Per-scanner ingest throttle — caps a (possibly leaked) scanner token to
# N ingest POSTs per rolling window. Expiry bounds token lifetime; this
# bounds blast radius within that lifetime. Keyed by scanner id (survives
# token rotation). Degrades open if Redis is unavailable.
SCANNER_RATE_MAX=60                       # ingests per window
SCANNER_RATE_WINDOW_S=3600                # window length (seconds)

# Phase Z — OIDC SSO is configured in-app at /admin/sso (OWNER), NOT via
# env. Config lives in Neo4j (:OidcConfig singleton); the client secret
# is AES-256-GCM sealed with CTI_SIGNING_MASTER_KEY (so that key is now
# also required if you use SSO). Generic OIDC — Keycloak / Google /
# Azure AD via standard discovery. Provisioning is invite-only.
